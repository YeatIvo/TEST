# Vorlage – NICHT ausfüllen. Kopiere zu `.env` und tippe die Werte dort selbst ein.
# `.env` wird nie gelesen/ausgegeben und nie committet.

# Alpaca PAPER-Konto (https://app.alpaca.markets -> Paper -> API Keys)
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER=true

# Optional: Telegram-Alerts (BotFather -> /newbot)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: FRED (VIX-Daten für Marktfilter 5B)
FRED_API_KEY=
